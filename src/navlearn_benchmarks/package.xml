<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navlearn_benchmarks</name>
  <version>0.1.0</version>
  <description>
    Benchmarking nodes for per-episode metrics:
    EpisodeManager, ControlMetric, TrajectoryMetric, and MetricsCompiler.
  </description>

  <maintainer email="mihir.kulkarni17@gmail.com">mihirmk</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core runtime deps -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>

  <!-- Messages -->
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>navlearn_msgs</depend>
  <depend>unique_identifier_msgs</depend>

  <!-- TF (used by EpisodeManager) -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>

  <!-- Tests -->
  <!-- world_to_map.py: DAE mesh loading (python3-collada is the rosdep key for
       pycollada) and hardened XML parsing of .world/.sdf files. Runtime script deps;
       test_world_to_map.py carries an importorskip guard for environments that never
       ran rosdep. -->
  <exec_depend>python3-collada</exec_depend>
  <exec_depend>python3-defusedxml</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
