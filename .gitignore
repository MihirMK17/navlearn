# ROS 2 workspace build artifacts. The bare names also cover accidental colcon runs
# from inside src/ (src/build etc.), which have happened.
build/
install/
log/

# local logs
build_log.txt
verbose_build.txt
*.log

# optional: vendor packages you don't want tracked
src/gz_ros2_control/


# IDE
.vscode/
src/.vscode/

# Personal docs — not for public repo (rebuild plan decision D-8)
docs/o1/
docs/paper1/
docs/council/
docs/decisions/
SESSION_LOG.md
BOOTSTRAP_PROMPT.md
CLAUDE.md
files.zip
files_extracted/

# Git worktrees
.worktrees/

# Local scratch / temp output files
navlearn-project/
bench.txt
bringup.txt
loc_eval.txt
scan_inf_nan.txt
scan_inf_nan_plusinf.txt

# Experiment artifacts — raw run output stays local; the paper dataset is published
# separately, not through git.
results/
benchmark_reports/
evaluations/

# Media policy: curated README assets ARE tracked (media/ must render on GitHub).
# Raw captures stay local: mp4s are never inlined by GitHub markdown, and personal
# photos have no business in a public research repo.
media/*.mp4
src/bumperbot_description/photos/

# Retired simulator assets (Isaac Sim was cut from Paper 1; local copies only)
IsaacSim/

# Tooling exhaust
graphify-out/
.claude-flow/
.claude.backup.*/
.claude/
.claudeignore

# Python caches
**/__pycache__/
**/*.pyc

# Stray root scratch
localization_evaluation.csv
